# ==============================================================================
# ARCHIVO DE CONFIGURACION DE I3 (v4)
# Tema: Gruvbox | Mod: Super
# 
# Aplicaciones externas utilizadas:
# - lxpolkit: Gestor de autenticacion para permisos de administrador
# - nm-applet: Gestor de conexiones de red en la bandeja del sistema
# - pasystray: Control de volumen y dispositivos de audio en la bandeja
# - picom: Compositor de efectos visuales y transparencias
# - redshift: Ajuste automatico de temperatura de color segun la hora
# - flameshot: Herramienta avanzada para capturas de pantalla
# - setxkbmap: Configuracion de la distribucion del teclado
# - xmessage: Utilidad grafica para mostrar mensajes emergentes
# - rofi: Lanzador de aplicaciones y menu de ejecucion
# - xfce4-terminal: Emulador de terminal ligero y versatil
# - wpctl: Utilidad de control de audio para PipeWire
# - playerctl: Utilidad para controlar reproductores multimedia mediante MPRIS
# - brightnessctl: Utilidad de linea de comandos para controlar el brillo de la pantalla
# ==============================================================================
# Fuente principal para titulos de ventanas y la barra
font pango:JetBrains Mono 10

# Definicion de la tecla Modificadora principal (Mod4 = Super / Tecla Windows)
set $mod Mod4

# ==============================================================================
# SECCION: APLICACIONES DE INICIO (AUTOSTART)
# ==============================================================================

# Bloqueador de pantalla vinculado al suspender sistema
exec --no-startup-id xset s off
exec --no-startup-id xset s noblank
exec --no-startup-id xset s noexpose
exec --no-startup-id xset dpms 0 0 0


# Factor DPI para monitores grandes
exec --no-startup-id xrdb -merge ~/.Xresources

# File: ~.Xresources
# Xft.dpi: 85
# Xft.antialias: 1
# Xft.hinting: 1
# Xft.hintstyle: hintslight
# Xft.rgba: rgb


exec --no-startup-id lxpolkit &
exec --no-startup-id nm-applet
exec --no-startup-id pasystray
exec --no-startup-id picom &
exec --no-startup-id redshift -m randr -Pl 0:0 -O 4000

# ==============================================================================
# SECCION: CONFIGURACION DE AUDIO (PULSEAUDIO)
# ==============================================================================

set $refresh_i3status killall -SIGUSR1 i3status

# Controles multimedia para volumen y microfono
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && $refresh_i3status
bindsym ctrl+$mod+Up exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%+
bindsym ctrl+$mod+Down exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%-

bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
# ==============================================================================
# SECCION: VARIABLES Y ATAJOS PRINCIPALES
# ==============================================================================

# Modificador para arrastrar ventanas flotantes con el raton
floating_modifier $mod
tiling_drag modifier titlebar

# Lanzar terminal (xfce4-terminal)
bindsym $mod+Return exec xfce4-terminal

# Cerrar ventana enfocada
bindsym $mod+Shift+q kill
bindsym $mod+q kill

# Lanzar menu de aplicaciones con Rofi
bindsym $mod+d exec "rofi -modi drun,run -show drun"
# Lanzar rofi modo ventana (listar aplicaciones activas)
# Simula comportamiento de Alt+TAB
bindsym Mod1+Tab exec --no-startup-id rofi -show window

# Herramienta de screenshots
bindsym $mod+Shift+s exec --no-startup-id flameshot gui

# Controles de brillo de pantalla
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 10%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
# ==============================================================================
# SECCION: CONTROL DE VENTANAS Y FOCO
# ==============================================================================

# Cambiar foco usando teclas Vim
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Cambiar foco usando flechas del teclado
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Mover ventana enfocada con flechas
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Modos de division horizontal y vertical
bindsym $mod+h split h
bindsym $mod+v split v

# Cambiar a pantalla completa
bindsym $mod+f fullscreen toggle

# Cambiar distribucion de contenedores (apilado, pestañas, alternar division)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Alternar entre ventana flotante y en mosaico
bindsym $mod+Shift+space floating toggle

# ==============================================================================
# SECCION: ESPACIOS DE TRABAJO (WORKSPACES) Y MONITORES
# ==============================================================================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "VGA"
set $ws6 "HDMI"

# Definicion de salidas de monitores
set $mon1 LVDS-1
set $mon2 VGA-1
set $mon3 HDMI-1

# Asignacion de workspaces a monitores segun preferencia
workspace $ws5 output $mon2
workspace $ws6 output $mon3

# Cambiar a espacio de trabajo
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6

# Mover contenedor actual a espacio de trabajo
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6

# ==============================================================================
# SECCION: GESTION DE SESION Y MODO REDIMENSIONAR
# ==============================================================================

# Recargar configuracion y reiniciar i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Desea salir de i3?' -B 'Si, salir' 'i3-msg exit'"

# Modo para redimensionar ventanas con teclado
mode "resize" {
        bindsym $left        resize shrink width 10 px or 10 ppt
        bindsym $down        resize grow height 10 px or 10 ppt
        bindsym $up          resize shrink height 10 px or 10 ppt
        bindsym $right       resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ==============================================================================
# SECCION: ESTILO VISUAL (TEMA GRUVBOX DARK)
# ==============================================================================
# Gaps
smart_gaps off
gaps outer 3
gaps inner 2

# Bordes de ventanas
for_window [class="^.*"] border pixel 2

# Definicion de colores de ventanas (Borde, Fondo, Texto, Indicador, Hijo)
client.focused          #d79921 #3c3836 #ebdbb2 #d79921 #d79921
client.focused_inactive #3c3836 #282828 #a89984 #3c3836 #3c3836
client.unfocused        #282828 #282828 #928374 #282828 #282828
client.urgent           #cc241d #cc241d #fbf1c7 #cc241d #cc241d
client.placeholder      #282828 #282828 #ebdbb2 #282828 #282828
client.background       #282828

# ==============================================================================
# SECCION: BARRA SUPERIOR (I3BAR CON I3STATUS)
# ==============================================================================

bar {
        status_command i3status
        position top
        height 24
        colors {
                background #282828
                statusline #ebdbb2
                separator  #3c3836

                #                  Borde   Fondo   Texto
                focused_workspace  #d79921 #3c3836 #ebdbb2
                active_workspace   #3c3836 #282828 #a89984
                inactive_workspace #282828 #282828 #928374
                urgent_workspace   #cc241d #cc241d #fbf1c7
        }
}
